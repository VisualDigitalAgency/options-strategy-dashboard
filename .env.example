# Copy to .env and fill in. Passwords are NOT here: run `python scripts/make_secrets.py`,
# which writes them to ./secrets/ (git-ignored, one file per password).

# Your domain, with DNS pointing at this server. Caddy fetches the HTTPS certificate itself.
# For a local test use: DOMAIN=localhost, HTTPS_PORT=8443, PUBLIC_URL=https://localhost:8443
DOMAIN=theta.example.com
# The exact address people open, used to refuse requests from other sites. Leave unset for
# https://$DOMAIN on the standard port.
# PUBLIC_URL=https://theta.example.com

# Ports Caddy listens on (defaults 80 and 443).
# HTTP_PORT=80
# HTTPS_PORT=443

# First admin's sign-in email. Set the password after the first start:
#   docker compose exec api python scripts/set_admin.py you@example.com
ADMIN_EMAIL=you@example.com

# Real broker connection (phase 1: Zerodha, admin accounts only — see
# doc/2026-09-26-broker-integration-phase1-zerodha.md). Register one Kite Connect app at
# developers.kite.trade; every user connects their own Zerodha account through it.
# KITE_API_KEY=your_kite_api_key
# KITE_REDIRECT_URL=https://theta.example.com/broker/zerodha/callback   # must match the app's registered redirect URL exactly
# The API secret is NOT an env var here: put it in ./secrets/kite_api_secret (one line, no
# trailing newline needed) the same way make_secrets.py writes the other passwords.
# ./secrets/broker_enc_key is generated automatically by `python scripts/make_secrets.py`.
