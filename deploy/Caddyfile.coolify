# Variant of ../deploy/Caddyfile for deployment behind Coolify's own Traefik proxy.
# Traefik terminates TLS and owns the host's 80/443, so Caddy here only serves plain HTTP
# on its container port and must not try to fetch its own certificate.
{
	auto_https off
	# Traefik is the only peer (Coolify's Docker network). It replaces any X-Forwarded-For it
	# didn't set, so the last entry is whoever connected to Traefik: a Cloudflare edge, or a
	# client that bypassed Cloudflare. {client_ip} is that address.
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For
	}
}

# Cloudflare's published ranges (https://www.cloudflare.com/ips/). Only from these is
# CF-Connecting-IP believed; anyone connecting to the origin directly can't spoof their IP.
(cloudflare) {
	@cloudflare client_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	vars visitor_ip {client_ip}
	vars @cloudflare visitor_ip {header.CF-Connecting-IP}
}

:80 {
	import cloudflare
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://www.tradingview-widget.com; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# The API (ProxyFix x_for=1) reads the last X-Forwarded-For entry; send only the visitor's IP.
	handle /rpc {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {vars.visitor_ip}
		}
	}
	handle /healthz {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {vars.visitor_ip}
		}
	}
	# Public share cards (#126): server-rendered so link previews work.
	handle /c/* {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {vars.visitor_ip}
		}
	}
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
